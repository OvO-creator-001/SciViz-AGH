{
  "name": "sciviz-agh",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "SciViz-AGH staged reading, public terminology research and offline academic/popular explainers",
  "engines": {
    "node": ">=24"
  },
  "exports": "./src/agh/index.mjs",
  "files": [
    "src",
    "ops/verify-agh-trace.mjs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify:trace": "node ops/verify-agh-trace.mjs",
    "sciviz": "node src/cli.mjs"
  },
  "agnes": {
    "plugins": [
      {
        "export": "main",
        "id": "ext:sciviz-agh/main",
        "inject": ["extension"]
      }
    ]
  }
}
